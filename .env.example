# PostgreSQL
POSTGRES_CONTAINER_NAME=travel-postgres
POSTGRES_DB=travel_db
POSTGRES_USER=travel_user
POSTGRES_PASSWORD=change-this-password

# Published ports
FRONTEND_HOST_PORT=80
BACKEND_HOST_PORT=8000

# Backend services
OPENAI_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_CLOUD_VISION_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
VISUAL_CROSSING_API_KEY=

# Comma-separated frontend origins allowed by FastAPI CORS.
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173

# Local non-Docker backend example:
DATABASE_URL=postgresql+psycopg://travel_user:change-this-password@127.0.0.1:5432/travel_db
