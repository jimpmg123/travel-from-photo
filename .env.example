# Docker Compose settings
POSTGRES_CONTAINER_NAME=travel-postgres
POSTGRES_DB=travel_db
POSTGRES_USER=travel_user
POSTGRES_PASSWORD=travel_password
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=80

# Backend external APIs
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
GOOGLE_MAPS_API_KEY=
GOOGLE_CLOUD_VISION_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
VISUAL_CROSSING_API_KEY=

# Auth
JWT_SECRET=change-this-to-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Email verification. Required for normal registration OTP.
EMAIL_FROM=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password

# Local deployment helper. Set true only for local testing to create sample accounts.
SEED_DB_ON_START=false
